{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/tasks/([^/]+)/toggle", "dest": "/api/tasks/[id]/toggle.js" },
    { "src": "/api/tasks/([^/]+)", "dest": "/api/tasks/[id]/index.js" },
    { "src": "/api/tasks", "dest": "/api/tasks/index.js" },
    { "src": "/api/categories", "dest": "/api/categories/index.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}